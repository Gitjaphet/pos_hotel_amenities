<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Type de chambre : kit standard de produits d'accueil. Affiché
         uniquement pour les rôles qui sont des offres de chambre, comme le
         bloc « Service de ménage » de booking_engine. -->
    <record id="planning_role_view_form_amenities" model="ir.ui.view">
        <field name="name">planning.role.form.amenities</field>
        <field name="model">planning.role</field>
        <field name="inherit_id" ref="planning.planning_role_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="/form/sheet" position="inside">
                <field name="x_is_a_room_offer" invisible="1"/>
                <group string="Produits d'accueil" invisible="not x_is_a_room_offer">
                    <field name="x_amenity_line_ids" nolabel="1" colspan="2">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="product_id"/>
                            <field name="uom_id" optional="show"/>
                            <field name="qty_checkout"/>
                            <field name="qty_stayover"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
