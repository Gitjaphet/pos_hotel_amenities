<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="amenity_supplement_wizard_form" model="ir.ui.view">
        <field name="name">pos.hotel.amenity.supplement.wizard.form</field>
        <field name="model">pos.hotel.amenity.supplement.wizard</field>
        <field name="arch" type="xml">
            <form string="Produits supplémentaires">
                <!-- task_id doit être dans la vue pour que la chambre
                     (champ related) s'affiche. -->
                <field name="task_id" invisible="1"/>
                <group>
                    <field name="room_id" readonly="1"/>
                </group>
                <field name="line_ids">
                    <list editable="bottom">
                        <field name="product_id"/>
                        <field name="uom_id" optional="show"/>
                        <field name="quantity"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object" string="Débiter du stock" class="btn-primary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
