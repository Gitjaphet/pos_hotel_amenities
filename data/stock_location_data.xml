<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Emplacement virtuel de consommation : tout produit d'accueil qui
             y entre est consommé (charge). Compte 602100 « Matières
             consommables » proposé s'il existe ; utilisé seulement si la
             catégorie du produit est en valorisation temps réel.
             noupdate : un hôtel peut changer le compte sans qu'une mise à
             jour du module ne l'écrase. -->
        <record id="stock_location_room_consumption" model="stock.location">
            <field name="name">Consommation chambres</field>
            <field name="usage">inventory</field>
            <field name="valuation_account_id" search="[('code', '=', '602100')]"/>
        </record>
    </data>
</odoo>
